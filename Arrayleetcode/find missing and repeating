 class Solution {
    // Finds the duplicate and missing numbers using sums and square sums.
    public int[] findNumbers(int[] nums) {
        long n = nums.length;
        long actualSum = 0;
        long actualSquareSum = 0;

        // Accumulate the two actual totals using wide integers.
        for (long value : nums) {
            actualSum += value;
            actualSquareSum += value * value;
        }

        long expectedSum = n * (n + 1) / 2;
        long expectedSquareSum = n * (n + 1) * (2 * n + 1) / 6;
        long difference = actualSum - expectedSum;
        long sumOfAnswers = (actualSquareSum - expectedSquareSum) / difference;

        // Use the sum and difference of the answers to find both numbers.
        long repeating = (difference + sumOfAnswers) / 2;
        long missing = repeating - difference;
        return new int[] {(int) repeating, (int) missing};
    }
}




